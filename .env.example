# --- LLM ---
# Interview OS uses Claude for question generation, evaluation, and reports.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
# Defaults to a local SQLite file if unset. For production, point this at
# your Supabase / PostgreSQL connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/interview_os
DATABASE_URL=sqlite:///./interview_os.db

# --- App ---
APP_ENV=development
SESSION_SECRET=change_me_to_a_random_string

# --- Voice (future stage) ---
# Leave unset to keep voice mode disabled in the UI.
SPEECH_TO_TEXT_PROVIDER=
